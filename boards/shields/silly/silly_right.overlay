#include "silly.dtsi"
#include <physical_layouts.dtsi>

&default_transform {
    col-offset = <6>;
};

&kscan_matrix {
    col-gpios
        = <&gpio0 5      GPIO_ACTIVE_HIGH>  /* C5 P0.05 */
        , <&gpio0 4      GPIO_ACTIVE_HIGH>  /* C4 P0.04 */
        , <&gpio0 3      GPIO_ACTIVE_HIGH>  /* C3 P0.03 */
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>  /* C2 P0.02 */
        , <&pro_micro 20 GPIO_ACTIVE_HIGH>  /* C1 P0.29 */
        , <&pro_micro 21 GPIO_ACTIVE_HIGH>  /* C0 P0.31 */
        ;
};
